{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["next", "dev"],
      "port": 3000
    },
    {
      "name": "web-file-mail",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_EMAIL_FILE=.e2e-mail.jsonl",
        "BETTER_AUTH_URL=http://localhost:3000",
        "./node_modules/.bin/next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["next", "start", "-p", "3200"],
      "port": 3200
    }
  ]
}
